generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  // In Prisma 7, we no longer put env() here. 
  // We specify only the provider.
}

enum Role {
  ADMIN
  SUBSCRIBER
  REGULAR
}

enum Category {
  BONDS
  DEVELOPED
  EMERGING
  GOLD
  BOOSTER
  CASH
  CRYPTO
  COMMODITIES
  UNKNOWN
  REAL_ESTATE // 🚀 Real estate, land plots, apartments
  CUSTOM // 🚀 Alternative assets (Wine, Art, Watches, Cars)
}

enum TimeHorizon {
  SHORT
  MEDIUM
  LONG
}

enum TransactionType {
  BUY
  SELL
  UPDATE
  DEPOSIT
  INTEREST
}

model Asset {
  id           String   @id @default(cuid())
  name         String
  ticker       String?
  category     Category
  quantity     Float    @default(0) // 🧱 Number of units (shares, bond units, grams of gold)
  nominalValue Float? // 🏷️ Nominal value (especially important for bonds, e.g., 100 PLN)

  // FINANCIAL BASE 💰📈
  investedCapital Float @default(0) // Physical amount deposited (e.g., 1000 PLN)
  currentValue    Float @default(0) // Current market valuation (e.g., 1300 PLN)

  targetPercentage Float @default(0)

  // GENERAL FOR BOOSTER & BONDS 🚀
  rationale   String? // Your thesis or reason for purchase
  timeHorizon TimeHorizon?

  // POLA DLA ALPHA / BOOSTER 💎
  expectedRoi Float?
  conviction  Int?
  riskLevel   String?

  // FIELDS FOR BONDS 📑
  purchaseDate DateTime
  maturityDate DateTime?
  interestRate Float?
  rateType     String? // "FIXED" or "VARIABLE"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  // FIELDS FOR OBSERVED MARKETS
  isObserved Boolean @default(false) // EN: Toggle to show on dashboard | PL: Flaga wyświetlania w sekcji Obserwowane

  dailyChange Float? @default(0) // EN: Percentage change in the last 24h | PL: Zmiana procentowa w 24h

  @@unique([portfolioId, ticker]) // Composite unique key preventing duplicate records in the same portfolio
}

// Portfolio model - represents a distinct investment strategy or bucket
model Portfolio {
  id          String   @id @default(cuid())
  name        String // e.g., "Retirement", "High Risk"
  description String? // Optional strategy details
  goal        Float? // Financial target for this specific portfolio 🎯
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // STRATEGY (Target Allocation) - sum should equal 100%
  targetDeveloped   Int @default(0)
  targetEmerging    Int @default(0)
  targetBonds       Int @default(0)
  targetGold        Int @default(0)
  targetBooster     Int @default(0)
  targetCash        Int @default(0) // ✅ Treated like any other asset
  targetCrypto      Int @default(0)
  targetCommodities Int @default(0)
  targetRealEstate  Int @default(0) // 🚀 Target % in real estate
  targetCustom      Int @default(0) // 🚀 Target % in alternative assets

  assets               Asset[] // Relation: One portfolio can house many assets
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentPlans      InvestmentPlan[]
  transactionHistories TransactionHistory[]
  // portfolioSnapshots   PortfolioSnapshot[]
  snapshots            PortfolioSnapshot[]
}

model InvestmentPlan {
  id             String   @id @default(cuid())
  name           String // np. "ETF MSCI World"
  ticker         String? // np. "EUNL.DE"
  value          Float // Kwota planowana
  plannedDate    String // Format "YYYY-MM" (dla Twojego kalendarza)
  conviction     Int? // Twoje przekonanie 0-100
  // Docelowe przeznaczenie (używamy Twoich stałych kategorii)
  targetCategory Category

  // Do którego portfela to ma trafić
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  rationale  String? // Twoje uzasadnienie "dlaczego?"
  isExecuted Boolean @default(false) // Czy już kupione?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isRecurring Boolean  @default(false)
}

model TransactionHistory {
  id         String          @id @default(cuid())
  externalId String?
  type       TransactionType @default(BUY)
  assetName  String
  ticker     String? // Optional for cash operations

  // Multi-currency support fields
  originalPrice    Float? // Price in EUR/USD extracted from XTB comment
  originalCurrency String? // EUR, USD, PLN
  exchangeRate     Float   @default(1.0)

  executedValue Float // Amount in PLN (from Amount column in Excel)
  category      Category
  executedAt    DateTime @default(now())
  rationale     String?
  comment       String?
  quantity      Float    @default(0)

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, externalId])
  // Index for performance when filtering by date and amount
  @@index([executedAt, executedValue])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // NEW FIELD: Hashed password

  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret    String? // Key for Google Authenticator (future implementation)

  accounts   Account[]
  sessions   Session[]
  portfolios Portfolio[] // Relation to portfolios

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role            Role            @default(REGULAR)
  // Array of global indices (tickers/IDs) selected by the user
  observedIndices String[]        @default([])
  deviceSessions  DeviceSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExchangeRate {
  id        String   @id @default(cuid())
  code      String   @unique // np. "USDPLN", "EURPLN", "GBPPLN"
  value     Float // aktualny kurs
  change    Float // zmiana procentowa (dla paska Ticker)
  updatedAt DateTime @updatedAt
}

model PortfolioSnapshot {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  totalValue    Float // Total value on a given day
  investedValue Float // Capital invested on a given day (for profit calculation)
  date          DateTime @default(now())

  @@index([portfolioId])
  @@index([date])
}

model MarketIndex {
  id          String         @id @default(cuid())
  symbol      String         @unique
  name        String?
  price       Float          @default(0)
  dailyChange Float          @default(0)
  updatedAt   DateTime       @updatedAt
  history     IndexHistory[]
}

// EN: Tracks active sessions for JWT invalidation and security audits
model DeviceSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String // EN: The IP address of the login
  userAgent  String // EN: The raw browser/device string
  createdAt  DateTime @default(now())
  lastActive DateTime @default(now())
  isValid    Boolean  @default(true) // EN: Set to false when user clicks "Revoke"
}

// NEW: Table for historical prices
model IndexHistory {
  id          String      @id @default(cuid())
  symbol      String
  marketIndex MarketIndex @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  closePrice Float // Closing price on a given day
  date       DateTime @default(now())

  // Safeguard: only one price per index for a specific date
  @@unique([symbol, date])
  @@index([symbol])
  @@index([date])
}
