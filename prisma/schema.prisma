generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  // In Prisma 7, we no longer put env() here. 
  // We specify only the provider.
}

enum Category {
  BONDS
  DEVELOPED
  EMERGING
  GOLD
  BOOSTER
  CASH
  CRYPTO
  COMMODITIES
}

enum TimeHorizon {
  SHORT
  MEDIUM
  LONG
}

model Asset {
  id       String   @id @default(cuid())
  name     String
  ticker   String?
  category Category

  // BAZA FINANSOWA 💰📈
  investedCapital Float @default(0) // Ile fizycznie wpłaciliśmy (np. 1000 PLN)
  currentValue    Float @default(0) // Aktualna wycena rynkowa (np. 1300 PLN)

  targetPercentage Float @default(0)

  // OGÓLNE DLA BOOSTER & BONDS 🚀
  rationale   String? // Twoja teza lub powód zakupu
  timeHorizon TimeHorizon?

  // POLA DLA ALPHA / BOOSTER 💎
  expectedRoi Float?
  conviction  Int?
  riskLevel   String?

  // POLA DLA OBLIGACJI (BONDS) 📑
  purchaseDate DateTime?
  maturityDate DateTime?
  interestRate Float?
  rateType     String? // "FIXED" lub "VARIABLE"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

// Portfolio model - represents a distinct investment strategy or bucket
model Portfolio {
  id          String   @id @default(cuid())
  name        String // e.g., "Emerytalny", "Ryzykowny"
  description String? // Optional strategy details
  goal        Float? // Financial target for this specific portfolio 🎯
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // STRATEGIA (Target Allocation) - suma powinna dawać 100%
  targetDeveloped   Int @default(0)
  targetEmerging    Int @default(0)
  targetBonds       Int @default(0)
  targetGold        Int @default(0)
  targetBooster     Int @default(0)
  targetCash        Int @default(0) // ✅ Traktujemy jak każde inne aktywo
  targetCrypto      Int @default(0)
  targetCommodities Int @default(0)

  assets               Asset[] // Relation: One portfolio can house many assets
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentPlans      InvestmentPlan[]
  transactionHistories TransactionHistory[]
}

model InvestmentPlan {
  id          String  @id @default(cuid())
  name        String // np. "ETF MSCI World"
  ticker      String? // np. "EUNL.DE"
  value       Float // Kwota planowana
  plannedDate String // Format "YYYY-MM" (dla Twojego kalendarza)

  // Docelowe przeznaczenie (używamy Twoich stałych kategorii)
  targetCategory Category

  // Do którego portfela to ma trafić
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  rationale  String? // Twoje uzasadnienie "dlaczego?"
  isExecuted Boolean @default(false) // Czy już kupione?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isRecurring Boolean  @default(false)
}

model TransactionHistory {
  id            String   @id @default(cuid())
  assetName     String // e.g., "ETF MSCI World"
  ticker        String? // e.g., "EUNL.DE"
  executedValue Float // The actual amount spent
  category      Category // e.g., BONDS, GOLD
  executedAt    DateTime @default(now())
  rationale     String? // Why did you buy this? (Copied from plan)

  // Reference to the portfolio
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  portfolios    Portfolio[] // Twoja relacja do portfeli

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
