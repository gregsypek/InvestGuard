// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // In Prisma 7, we no longer put env() here. 
  // We specify only the provider.
}

enum Category {
  BONDS
  DEVELOPED
  EMERGING
  GOLD
  BOOSTER
  CASH
}

enum TimeHorizon {
  SHORT
  MEDIUM
  LONG
}

model Asset {
  id               String   @id @default(cuid())
  name             String
  ticker           String? // Pytajnik oznacza, że pole jest opcjonalne (Twoja prośba!)
  category         Category
  value            Float
  targetPercentage Float    @default(0)

  // Nowe pola dla sekcji Booster
  rationale   String? // Opcjonalne, bo EDO ich nie potrzebują
  timeHorizon TimeHorizon? // Korzystamy z Enuma powyżej

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Relacja z Portfelem 🔗
  portfolioId String // 1. Pole techniczne (Klucz obcy)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade) // 2. Definicja relacji dla Pragmy
}

// Portfolio model - represents a distinct investment strategy or bucket
model Portfolio {
  id          String   @id @default(cuid())
  name        String // e.g., "Emerytalny", "Ryzykowny"
  description String? // Optional strategy details
  goal        Float? // Financial target for this specific portfolio 🎯
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // STRATEGIA (Target Allocation) - suma powinna dawać 100%
  targetDeveloped Int @default(0)
  targetEmerging  Int @default(0)
  targetBonds     Int @default(0)
  targetGold      Int @default(0)
  targetBooster   Int @default(0)
  targetCash      Int @default(0) // ✅ Traktujemy jak każde inne aktywo

  assets Asset[] // Relation: One portfolio can house many assets
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id         String      @id @default(cuid())
  name       String?
  email      String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  portfolios Portfolio[] // Relacja: Użytkownik ma wiele portfeli
}
