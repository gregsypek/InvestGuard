generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // BRAK URL - Prisma 7 pobierze go z prisma.config.ts podczas migracji
}

enum Role {
  ADMIN
  SUBSCRIBER
  REGULAR
}

enum Category {
  BONDS
  DEVELOPED
  EMERGING
  GOLD
  BOOSTER
  CASH
  CRYPTO
  COMMODITIES
  UNKNOWN
  UNKNOWN
}

enum TimeHorizon {
  SHORT
  MEDIUM
  LONG
}

enum TransactionType {
  BUY
  SELL
  UPDATE
  DEPOSIT
  INTEREST
}

model Asset {
  id           String   @id @default(cuid())
  name         String
  ticker       String?
  category     Category
  quantity     Float    @default(0) // 🧱 Liczba jednostek (akcji, sztuk obligacji, gramów złota)
  nominalValue Float? // 🏷️ Wartość nominalna (szczególnie ważna dla obligacji, np. 100 PLN)

  // BAZA FINANSOWA 💰📈
  investedCapital Float @default(0) // Ile fizycznie wpłaciliśmy (np. 1000 PLN)
  currentValue    Float @default(0) // Aktualna wycena rynkowa (np. 1300 PLN)

  targetPercentage Float @default(0)

  // OGÓLNE DLA BOOSTER & BONDS 🚀
  rationale   String? // Twoja teza lub powód zakupu
  timeHorizon TimeHorizon?

  // POLA DLA ALPHA / BOOSTER 💎
  expectedRoi Float?
  conviction  Int?
  riskLevel   String?

  // POLA DLA OBLIGACJI (BONDS) 📑
  purchaseDate DateTime
  maturityDate DateTime?
  interestRate Float?
  rateType     String? // "FIXED" lub "VARIABLE"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  dailyChange Float? @default(0) // EN: Percentage change in the last 24h | PL: Zmiana procentowa w 24h

  @@unique([portfolioId, ticker]) //unikalny klucz złożony, który uniemożliwi stworzenie dwóch rekordów w tym samym portfelu
}

// Portfolio model - represents a distinct investment strategy or bucket
model Portfolio {
  id          String   @id @default(cuid())
  name        String // e.g., "Emerytalny", "Ryzykowny"
  description String? // Optional strategy details
  goal        Float? // Financial target for this specific portfolio 🎯
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // STRATEGIA (Target Allocation) - suma powinna dawać 100%
  targetDeveloped   Int @default(0)
  targetEmerging    Int @default(0)
  targetBonds       Int @default(0)
  targetGold        Int @default(0)
  targetBooster     Int @default(0)
  targetCash        Int @default(0) // ✅ Traktujemy jak każde inne aktywo
  targetCrypto      Int @default(0)
  targetCommodities Int @default(0)

  assets               Asset[] // Relation: One portfolio can house many assets
  userId               String
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentPlans      InvestmentPlan[]
  transactionHistories TransactionHistory[]
}

model InvestmentPlan {
  id             String   @id @default(cuid())
  name           String // np. "ETF MSCI World"
  ticker         String? // np. "EUNL.DE"
  value          Float // Kwota planowana
  plannedDate    String // Format "YYYY-MM" (dla Twojego kalendarza)
  conviction     Int? // Twoje przekonanie 0-100
  // Docelowe przeznaczenie (używamy Twoich stałych kategorii)
  targetCategory Category

  // Do którego portfela to ma trafić
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  rationale  String? // Twoje uzasadnienie "dlaczego?"
  isExecuted Boolean @default(false) // Czy już kupione?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isRecurring Boolean  @default(false)
}

model TransactionHistory {
  id         String          @id @default(cuid())
  externalId String?
  type       TransactionType @default(BUY)
  assetName  String
  ticker     String? // EN: Optional for cash operations

  // EN: Multi-currency support fields
  // PL: Pola wspierające wiele walut
  originalPrice    Float? // Cena w EUR/USD wyciągnięta z komentarza XTB
  originalCurrency String? // EUR, USD, PLN
  exchangeRate     Float   @default(1.0)

  executedValue Float // Kwota w PLN (z kolumny Amount w Excelu)
  category      Category
  executedAt    DateTime @default(now())
  rationale     String?
  comment       String?
  quantity      Float    @default(0)

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, externalId])
  // Indeks dla wydajności przy filtrowaniu po dacie i kwocie
  @@index([executedAt, executedValue])
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  portfolios    Portfolio[] // Twoja relacja do portfeli

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role @default(REGULAR)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExchangeRate {
  id        String   @id @default(cuid())
  code      String   @unique // np. "USDPLN", "EURPLN", "GBPPLN"
  value     Float // aktualny kurs
  change    Float // zmiana procentowa (dla paska Ticker)
  updatedAt DateTime @updatedAt
}
